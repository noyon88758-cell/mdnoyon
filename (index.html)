            navigator.clipboard.writeText(number);
            const alertBox = document.getElementById('copyAlert');
            alertBox.classList.remove('hidden');
            setTimeout(() => {
                alertBox.classList.add('hidden');
            }, 3000);
        }

        // Select Package Function
        function selectPackage(name, price) {
            document.getElementById('selectedPackageInput').value = `${name} - ${price}`;
            // Smooth scroll to order form
            document.getElementById('order').scrollIntoView({ behavior: 'smooth' });
        }

        // Handle Order Form Submit
        function handleOrder(event) {
            event.preventDefault();
            const selectedPkg = document.getElementById('selectedPackageInput').value;
            if(selectedPkg.includes('কোন প্যাকেজ সিলেক্ট করা হয়নি')) {
                alert('দয়া করে প্রথমে যেকোনো একটি প্যাকেজ সিলেক্ট করুন!');
                document.getElementById('packages').scrollIntoView({ behavior: 'smooth' });
                return;
            }
            // Show Success Modal
            document.getElementById('successModal').classList.remove('hidden');
            document.getElementById('successModal').classList.add('flex');
        }

        // Close Modal
        function closeModal() {
            document.getElementById('successModal').classList.add('hidden');
            document.getElementById('successModal').classList.remove('flex');
            // Reset form
            document.querySelector('form').reset();
            document.getElementById('selectedPackageInput').value = "কোন প্যাকেজ সিলেক্ট করা হয়নি";
        }
    </script>
</body>
</html>